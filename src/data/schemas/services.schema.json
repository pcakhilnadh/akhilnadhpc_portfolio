{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Services",
  "description": "What you offer.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Service name."
          },
          "description": {
            "type": "string",
            "description": "One or two sentences."
          },
          "category": {
            "type": "string",
            "description": "Grouping label."
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Bullet points."
          }
        },
        "required": [
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "services"
  ],
  "additionalProperties": false
}
