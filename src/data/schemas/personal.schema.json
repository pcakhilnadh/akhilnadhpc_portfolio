{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Personal (private)",
  "description": "Sensitive details. The website never imports this file. No phone number or full date of birth is kept here. Consider keeping it out of a public repository.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "birthMonth": {
      "type": "string",
      "description": "Month and year of birth, YYYY-MM. The full date is deliberately not stored.",
      "pattern": "^d{4}-(0[1-9]|1[0-2])$"
    },
    "placeOfBirth": {
      "type": "string",
      "description": "Where you were born."
    },
    "maritalStatus": {
      "type": "string",
      "description": "Marital status."
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "description": "Street / house."
        },
        "postalCode": {
          "type": "string",
          "description": "Postal code."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "family": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relationship": {
            "type": "string",
            "description": "e.g. Father."
          },
          "name": {
            "type": "string",
            "description": "Name."
          },
          "occupation": {
            "type": "string",
            "description": "Occupation."
          },
          "birthMonth": {
            "type": "string",
            "description": "Month and year of birth, YYYY-MM. The full date is deliberately not stored.",
            "pattern": "^d{4}-(0[1-9]|1[0-2])$"
          },
          "profileUrl": {
            "type": "string",
            "description": "Public profile.",
            "format": "uri"
          }
        },
        "required": [
          "relationship",
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [],
  "additionalProperties": false
}
